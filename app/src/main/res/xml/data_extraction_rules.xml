<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Ни облачная копия, ни перенос между устройствами не включают данные RW AI (переписки, ключ, журнал). -->
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
